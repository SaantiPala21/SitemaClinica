<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!--
          Base de datos SQLite de la clínica: un único archivo (clinica.db).
          |DataDirectory| es la carpeta donde está el .exe. El archivo se crea solo
          la primera vez que se ejecuta el programa.
        -->
        <add name="SistemaClinica"
             connectionString="Data Source=|DataDirectory|\clinica.db;Version=3"
             providerName="System.Data.SQLite" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
